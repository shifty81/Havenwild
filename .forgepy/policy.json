{
  "schema": "forgepy.universal.policy.v5",
  "guiDefault": true,
  "consoleFallback": true,
  "automaticRepositoryScan": true,
  "scanMaxDepth": 7,
  "scanMaxComponents": 96,
  "scanCacheEnabled": true,
  "autoApplyPatches": false,
  "startupIntakePrompt": true,
  "allowZipPatchApplication": false,
  "genericPatchRequiresSourceCleanliness": true,
  "genericPatchIgnoresIntakeArtifactsForCleanCheck": true,
  "genericPatchMaxBytes": 134217728,
  "protectForgePYRuntimeFromGenericProjectPatches": true,
  "protectProjectIdentityFromGenericProjectPatches": true,
  "protectExecutionControlMetadataFromGenericPatches": true,
  "archiveAppliedPatchesWithReceipt": true,
  "preserveExistingProjectControl": true,
  "preserveExistingPCCLauncher": true,
  "upgradeLegacyForgePYLauncher": true,
  "pullFastForwardOnly": true,
  "pushRequiresConfiguredUpstream": true,
  "jsonlStdoutStrict": true,
  "operationLockStaleSeconds": 21600,
  "defaultGateTimeoutSeconds": 3600,
  "defaultBuildTimeoutSeconds": 3600,
  "defaultTestTimeoutSeconds": 3600,
  "defaultRunTimeoutSeconds": 0,
  "globalVaultRequired": false,
  "downloadsWatcherEnabled": false,
  "networkRequired": false
}
