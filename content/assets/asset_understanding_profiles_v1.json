{
  "schema": "havenwild.asset_understanding_profiles.v1",
  "version": 1,
  "authority": "candidate_only",
  "rule": "Profiles may propose classifications and review priority. They never create runtime authority by themselves.",
  "priorityOrder": [
    "terrain",
    "water",
    "cliffs",
    "paths",
    "trees",
    "structures"
  ],
  "domains": [
    {
      "id": "terrain",
      "sourcePrefix": "Terrain/",
      "candidateKinds": [
        "terrain_primitive",
        "multi_tile_stamp",
        "placeable_object"
      ],
      "requiredForRuntimeCertification": [
        "sourceRectOrComponent",
        "semanticRole",
        "provenance",
        "visualTopologyOrPlacementContract"
      ]
    },
    {
      "id": "water",
      "sourcePrefix": "Terrain/",
      "nameHints": [
        "water",
        "river",
        "ocean",
        "shore",
        "coast",
        "foam"
      ],
      "candidateKinds": [
        "terrain_primitive",
        "multi_tile_stamp"
      ],
      "requiredForRuntimeCertification": [
        "sourceRectOrComponent",
        "semanticRole",
        "connectionTopology",
        "provenance"
      ]
    },
    {
      "id": "cliffs",
      "sourcePrefix": "Terrain/",
      "nameHints": [
        "cliff",
        "ramp",
        "ledge",
        "waterfall"
      ],
      "candidateKinds": [
        "multi_tile_stamp"
      ],
      "requiredForRuntimeCertification": [
        "sourceRectOrComponent",
        "semanticRole",
        "footprint",
        "connectionTopology",
        "anchorOrReceiverRows",
        "provenance"
      ]
    },
    {
      "id": "paths",
      "sourcePrefix": "Terrain/",
      "nameHints": [
        "path",
        "road",
        "trail",
        "bridge"
      ],
      "candidateKinds": [
        "terrain_primitive",
        "multi_tile_stamp"
      ],
      "requiredForRuntimeCertification": [
        "sourceRectOrComponent",
        "semanticRole",
        "connectionTopology",
        "provenance"
      ]
    },
    {
      "id": "trees",
      "sourcePrefix": "Terrain/",
      "nameHints": [
        "tree",
        "sapling",
        "stump",
        "trunk"
      ],
      "candidateKinds": [
        "placeable_object"
      ],
      "requiredForRuntimeCertification": [
        "sourceRectOrComponent",
        "semanticRole",
        "visualFootprint",
        "bottomAnchor",
        "collisionFootprint",
        "provenance"
      ]
    },
    {
      "id": "structures",
      "sourcePrefix": "Structure/",
      "candidateKinds": [
        "structure_component_or_assembly"
      ],
      "requiredForRuntimeCertification": [
        "sourceRectOrComponent",
        "semanticRole",
        "visualFootprint",
        "anchorOrSocketContract",
        "collisionFootprint",
        "provenance"
      ]
    }
  ],
  "confidencePolicy": {
    "filenameFolderMetadataMayPropose": true,
    "gridOccupancyMayPropose": true,
    "connectedComponentAnalysisMayPropose": true,
    "knownLpcLayoutMayPropose": true,
    "automaticRuntimeCertification": false,
    "ambiguousCandidateRequiresReview": true
  }
}
