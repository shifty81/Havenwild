  "stable_reference_fields": ["pack_id", "category", "asset_id", "source_id", "variant_id"],
  "save_record": "object_asset",
  "legacy_object_kind_role": "compatibility_fallback_only",
  "editor_selection_sources": ["content_library", "native_placeable_registry", "f3_placeable_cycle"],
  "requirements": {
