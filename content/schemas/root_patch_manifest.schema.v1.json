{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "havenwild.root_patch.v1",
  "title": "Havenwild Root Incremental Patch Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "patchId",
    "applyMode",
    "files",
    "remove"
  ],
  "properties": {
    "schema": {
      "const": "havenwild.root_patch.v1"
    },
    "project": {
      "const": "Havenwild"
    },
    "patchId": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "string",
      "minLength": 1
    },
    "createdUtc": {
      "type": "string"
    },
    "applyMode": {
      "const": "overwrite"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "remove": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
