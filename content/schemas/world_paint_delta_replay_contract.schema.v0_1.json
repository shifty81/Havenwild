{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Havenwild World Paint Delta Replay Contract v0.1",
  "type": "object",
  "required": ["schema", "version", "purpose", "sourceDeltaDocument", "canonicalTileSize", "replayScope", "authoritativeInputs", "derivedClientOutputs", "rules"],
  "properties": {
    "schema": { "const": "havenwild.world_paint_delta_replay_contract.v0.1" },
    "version": { "const": 1 },
    "purpose": { "type": "string", "minLength": 8 },
    "sourceDeltaDocument": { "type": "string", "minLength": 1 },
    "canonicalTileSize": {
      "type": "array",
      "prefixItems": [{ "const": 32 }, { "const": 32 }],
      "minItems": 2,
      "maxItems": 2
    },
    "replayScope": {
      "type": "array",
      "items": { "enum": ["active_scene", "all_scenes"] },
      "minItems": 2,
      "uniqueItems": true
    },
    "authoritativeInputs": { "type": "array", "items": { "type": "string" }, "minItems": 8 },
    "derivedClientOutputs": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "rules": { "type": "array", "items": { "type": "string" }, "minItems": 4 }
  }
}
