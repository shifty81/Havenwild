    "requiresCleanExperimental": true,
    "requiresExperimentalGreen": true,
    "requiresMainComparison": true,
    "requiresPostCutoverMainGreen": true
  },
  "notes": [
    "Git branch identity is authoritative; local .havenwild lane state is supporting metadata only.",
