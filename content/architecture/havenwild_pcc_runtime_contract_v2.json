{
  "schema": "havenwild.pcc_runtime_contract.v2",
  "project": "Havenwild",
  "lane": "experimental",
  "shell": {
    "authority": "tools/control/HavenwildPccHost.ps1",
    "legacyBackend": "tools/control/HavenwildTools.ps1",
    "principle": "shell orchestration and command execution are separate authorities"
  },
  "frontDoor": {
    "provider": "tools/control/PccQuickState.py",
    "prohibitsGovernedSourceHashing": true,
    "networkRequired": false,
    "branchAwareRemoteTracking": true,
    "quickCertificationReceipt": ".havenwild/pcc/quick-certification.json",
    "rehashesOnlyChangedPaths": true,
    "postGateUncommittedGreenSupported": true
  },
  "restart": {
    "authority": "tools/control/PccRestartTicket.ps1",
    "lifecycleContract": "content/architecture/havenwild_pcc_lifecycle_contract_v3.json",
    "validator": "tools/validation/Validate-HavenwildPccLifecycle.py",
    "maxAutomaticRestartsPerUpdate": 1,
    "synchronousNestedPcc": false,
    "emptyInteractiveInputExits": true,
    "gateResumeUsesOriginalCommand": true,
    "cliSelfUpdateWaitsForResumedCommand": true,
    "interactiveSelfUpdateTransfersMenuOwnershipOnce": true
  },
  "patchIntake": {
    "authority": "tools/control/InvokeRootPatchIntake.ps1",
    "preflight": "tools/control/PccPatchPreflight.ps1",
    "ledger": "tools/control/PccPatchLedger.ps1",
    "lanePreflightBeforeMutation": true,
    "mainToExperimentalMayBeAutomaticWhenSafe": true,
    "experimentalToMainAutomaticSwitch": false,
    "requiredFailedPatchBlocksGate": true,
    "states": [
      "PENDING",
      "APPLIED",
      "FAILED",
      "DEFERRED"
    ],
    "archiveEvidenceDeterminesAppliedVsFailed": true,
    "legacyNonBlockingFailureCannotMasqueradeAsApplied": true
  },
  "commands": {
    "registry": "tools/control/ProjectCommandRegistry.ps1",
    "extensions": "tools/control/PccCommandExtensions.ps1",
    "executionBackend": "tools/control/HavenwildTools.ps1",
    "provider": "tools/forge/HavenwildPccProvider.py",
    "providerReadsLiveRegistry": true
  },
  "jobs": {
    "authority": "tools/control/PccJobHost.ps1",
    "receipts": ".havenwild/jobs",
    "structured": true
  },
  "editorArchitecture": {
    "profile": "content/editor/architecture/havenwild_tooling_profile_v2.json",
    "validator": "tools/validation/Validate-HavenwildEditorArchitectureV2.py",
    "preflightBeforeFullGate": true
  },
  "certification": {
    "fullGateRemainsCanonical": "validation.full-quality-gate",
    "fullHashingAllowed": [
      "full-gate",
      "protected-commit",
      "protected-publication",
      "explicit-certification"
    ],
    "frontDoorIsNotCertification": true
  },
  "vault": {
    "contract": "pcc.universal_vault_contract.v1",
    "adapter": "tools/control/PccVaultAdapter.py",
    "defaultWindowsRoot": "D:\\Vault",
    "resolutionOrder": [
      "project_mount",
      "vault_source",
      "project_cache",
      "vault_archive",
      "explicit_override",
      "network"
    ],
    "networkIsLastResort": true,
    "verifiedKnownLicenseMayAutoPromote": true,
    "ambiguousContentRequiresReviewOrQuarantine": true
  }
}
