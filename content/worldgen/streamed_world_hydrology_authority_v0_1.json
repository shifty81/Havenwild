    "elevated_source_requires_outflow": true,
    "structural_drop_requires_waterfall": true,
    "valid_sinks": [
      "pond",
      "lake",
      "joined_watercourse",
      "ocean"
    ],
    "forbid_uphill_reentry_after_descent": true,
    "forbid_arbitrary_land_termination": true,
    "waterfall_art_is_presentation_not_topology": true,
    "freshwater_retains_underlying_structural_level": true,
    "notes": "Waterfall density may influence how commonly waterfall-producing upland drainage features occur, but may never suppress a waterfall where generated freshwater actually crosses a structural level drop.",
