{
  "schema": "havenwild.streamed_world_hydrology_authority.v0_1",
  "pass": "Pass167Z109",
  "purpose": "Lock finite and endless Havenwild surfaces to one deterministic geographic sampler and require generated freshwater to own complete downhill drainage paths with waterfall connectors at every structural drop.",
  "world_extent": {
    "finite_presets_tiles": {
      "compact": [
        4096,
        4096
      ],
      "standard": [
        8192,
        8192
      ],
      "large": [
        16384,
        16384
      ],
      "huge": [
        24576,
        24576
      ],
      "massive": [
        32768,
        32768
      ],
      "enormous": [
        65536,
        65536
      ]
    },
    "endless_supported": true,
    "geographic_region_size_tiles": 2048,
    "storage_chunk_size_tiles": 64,
    "rule": "Storage chunks partition persistence and streaming only. They never create geographic boundaries."
  },
  "difficulty": {
    "curated_presets": [
      "story",
      "peaceful",
      "relaxed",
      "standard",
      "adventurous",
      "rugged",
      "harsh",
      "wild"
    ],
    "custom_supported": true,
    "geography_is_independent_from_difficulty": true
  },
  "hydrology": {
