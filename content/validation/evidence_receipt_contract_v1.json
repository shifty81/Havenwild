{
  "schema": "havenwild.validation.evidence_receipt_contract.v1",
  "version": 1,
  "policy": {
    "generatedEvidenceIsSourceAuthority": false,
    "generatedEvidenceMayBlockCleanCheckout": false,
    "debugBundlesAutoGeneratedByControlCenter": true,
    "retainHistoricalSourceEvidence": true
  },
  "generatedRoots": [
    "artifacts/validation",
    "artifacts/debug",
    "artifacts/updates",
    "logs"
  ],
  "durableSourceEvidenceRoots": [
    "docs/audits",
    "docs/archive/pass_history",
    "manifests/validation/legacy"
  ],
  "receipts": [
    {
      "id": "validation-report",
      "schema": "havenwild.validation.report.v3",
      "destination": "artifacts/validation"
    },
    {
      "id": "root-patch-receipt",
      "schema": "havenwild.last_applied_patch.v1",
      "destination": ".havenwild/updates/last-applied.json"
    },
    {
      "id": "debug-bundle",
      "schema": "havenwild.debug_bundle",
      "destination": "artifacts/debug"
    }
  ]
}
