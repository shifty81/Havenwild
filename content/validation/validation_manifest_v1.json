  "policy": {
    "authoritativeRegistry": "content/build/validator_registry_v3.json",
    "historicalManifest": "manifests/validation/legacy/validation_manifest_pass167z9.json",
    "generatorsAreNeverImplicitValidationGates": true,
    "futurePassRule": "Keep normal build gates at two. Add subsystem checks as certification-only unless they protect repository readability or owned content parsing.",
    "nativeDomainSubchecks": [
      "validate-archipelagoworldskeletonv140",
      "validate-chunkpersistencenormalizationv144",
      "validate-editorcommandundonormalizationv145",
      "validate-shorewaterlifecyclev138",
      "validate-terrainworldsemanticregistryv142",
      "validate-worldgenerationpipelineownershipv143",
      "validate-wrappedworldcoordinatefoundationv139"
    ],
    "normalBuildProfile": "build",
    "normalBuildValidatorCount": 2,
    "sourceValidationValidatorCount": 10
  },
  "profiles": {
    "quick": {
      "domains": [
        "architecture",
        "content"
      ],
      "includeKinds": [
        "validator"
      ],
      "lifecycles": [
        "build-gate"
      ],
      "description": "Alias of the normal build-gate profile."
    },
    "source": {
      "domains": [
        "architecture",
        "content"
      ],
      "includeKinds": [
        "validator"
      ],
      "lifecycles": [
        "build-gate",
        "source-audit"
      ],
      "description": "Ten current-authority checks. Historical pass validators remain explicit full/certification evidence rather than chaining through normal source validation."
    },
    "legacy": {
      "domains": [
        "architecture",
        "content",
        "world",
        "editor"
      ],
      "includeKinds": [
        "validator",
        "generator"
      ],
      "lifecycles": [
        "legacy-reference"
      ]
    },
    "full": {
      "domains": [
        "architecture",
        "content",
        "world",
        "editor"
      ],
      "includeKinds": [
        "validator"
      ],
      "lifecycles": [
        "build-gate",
        "source-audit",
        "certification-only",
        "framework-audit"
      ],
      "cargo": [
        "fmt-check",
        "check",
        "clippy",
        "test"
      ],
      "description": "Explicit release/certification profile; never run implicitly by Build all."
    },
    "generation": {
      "domains": [
        "architecture",
        "content",
        "world",
        "editor"
      ],
      "includeKinds": [
        "generator"
      ],
      "lifecycles": [
        "active"
      ]
    },
    "build": {
      "domains": [
        "architecture",
        "content"
      ],
      "includeKinds": [
        "validator"
      ],
      "lifecycles": [
        "build-gate"
      ],
      "description": "Two lightweight pre-Cargo checks used by normal builds; Rust compile/build remains owned by the build scripts."
    },
    "framework": {
      "domains": [
        "architecture"
      ],
      "includeKinds": [
        "validator"
      ],
      "lifecycles": [
        "framework-audit"
      ],
      "description": "Validation framework self-tests and quality checks only."
    }
  },
