    "defaultSnapPx": 8,
    "allowedSnapPx": [32, 16, 8, 4, 2, 1],
    "runtimeRepresentation": "compiled_merged_rectangles_or_contours",
    "futureChannels": [
      "physical",
      "navigation",
      "projectile",
      "vision",
      "overhead",
      "interaction",
      "shelter"
