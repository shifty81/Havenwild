{
  "schema": "havenwild.selection_junction_collision_authoring.v1",
  "pass": "167Z109W58ABC",
  "authority": "Scoped Pixel Studio round-trip over semantic world data",
  "editScopes": [
    "asset_source_shared",
    "cell_or_instance_variant",
    "selected_region",
    "building_composite",
